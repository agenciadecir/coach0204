# ===========================================
# VARIABLES DE ENTORNO - GYM COACH APP
# ============================================
# Copia este archivo como .env y completa los valores
# Para producción en Vercel, configura estas variables en el dashboard

# -------------------------------------------
# BASE DE DATOS (Neon / PostgreSQL)
# -------------------------------------------

# URL de conexión (pooler para consultas normales)
# Neon: postgresql://[user]:[password]@[host].neon.tech/[db]?sslmode=require
# Supabase: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://tu-usuario:tu-password@tu-host.neon.tech/tu-db?sslmode=require"

# URL directa (para migraciones)
# Neon: usa la misma URL que DATABASE_URL
# Supabase: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://tu-usuario:tu-password@tu-host.neon.tech/tu-db?sslmode=require"

# -------------------------------------------
# NEXTAUTH (Autenticación)
# -------------------------------------------

# Secreto para firmar tokens JWT
# Genera uno con: openssl rand -base64 32
# O usa este ejemplo (cambia en producción):
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-seguro-de-32-caracteres-minimo"

# URL de la aplicación
# Desarrollo: http://localhost:3000
# Producción: https://tu-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------
# PRISMA (Solo para Vercel)
# -------------------------------------------
# Ignora errores de checksum en Vercel
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
