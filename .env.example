# ===========================================
# VARIABLES DE ENTORNO - GYM COACH APP
# ===========================================
# Copia este archivo como .env y completa los valores
# Para producción en Vercel, configura estas variables en el dashboard

# -------------------------------------------
# BASE DE DATOS (Supabase/PostgreSQL)
# -------------------------------------------

# URL de conexión con pooler (para consultas normales)
# Formato: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL directa (para migraciones)
# Formato: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -------------------------------------------
# NEXTAUTH (Autenticación)
# -------------------------------------------

# Secreto para firmar tokens JWT
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secreto-super-seguro-aqui-cambiar-en-produccion"

# URL de la aplicación
# Desarrollo: http://localhost:3000
# Producción: https://tu-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------
# OPCIONAL: Supabase API (para features extra)
# -------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica"

# -------------------------------------------
# OPCIONAL: Upload/Storage
# -------------------------------------------
# Si usas un servicio de storage externo
# STORAGE_ENDPOINT="..."
# STORAGE_ACCESS_KEY="..."
# STORAGE_SECRET_KEY="..."
# STORAGE_BUCKET="..."
